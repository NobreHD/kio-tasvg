[Unit]
Description=Theme-Aware SVG Thumbnail Cache Sync Daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=@KDE_INSTALL_FULL_BINDIR@/tasvg-daemon
Restart=on-failure

[Install]
WantedBy=graphical-session.target